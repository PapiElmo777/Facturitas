<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["blazor.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>
<script>
    window.teclasPresionadas = "";
    
    document.addEventListener('keydown', function(event) {
        if(event.target.tagName === 'INPUT') return;
        window.teclasPresionadas += event.key.toUpperCase();
        if(window.teclasPresionadas.length > 20) {
            window.teclasPresionadas = window.teclasPresionadas.slice(-20);
        }
        if(window.teclasPresionadas.includes("ALGARACLOS")) {
            window.teclasPresionadas = "";
            document.getElementById('btn-secret-trigger').click();
        }
    });
</script>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

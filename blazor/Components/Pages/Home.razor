@page "/"
@using blazor.Components.Data
@using blazor.Components.Servicios
@using System.Globalization
@rendermode InteractiveServer
@inject ServicioControlador controlador
@inject NavigationManager Navegador

<PageTitle>BaronRojo</PageTitle>
<hr style="height: 6px; background-color: rgb(0, 0, 0)">
<div style="text-align: center; margin-bottom: 20px;">
    <h1>BaronRojo SteakHouse</h1>
    <p>Sistema de Gestion de Facturas y Ventas</p>
</div>
<div style="margin-bottom: 30px; padding: 15px; border: 1px solid #ccc;">
    <h3 style="margin-top: 0;">Cuadro de Honor</h3>
    
    <div style="display: flex; flex-wrap: wrap; gap: 40px;">
        
        <div>
            <strong>Mejor Cliente</strong>
            <div style="font-size: 1.1em;">@statsMejorCliente</div>
        </div>

        <div>
            <strong>Platillo Mas Vendido</strong>
            <div style="font-size: 1.1em;">@statsPlatilloTop</div>
        </div>

        <div>
            <strong>Bebida Mas Vendida</strong>
            <div style="font-size: 1.1em;">@statsBebidaTop</div>
        </div>

        <div>
            <strong>Records de Factura</strong>
            <div>Mas Cara: @statsFacturaCara</div>
            <div>Mas Barata: @statsFacturaBarata</div>
        </div>

        <div>
            <strong>Mejores Tiempos</strong>
            <div>Mejor Mes: @statsMejorMes</div>
            <div>Mejor Año: @statsMejorAnio</div>
        </div>
    </div>
</div> 
<hr style="height: 6px; background-color: rgb(0, 0, 0)">
<h4>@(facturaEnEdicion == null ? "Crear Nueva Factura" : $"Editando Factura ID: {facturaEnEdicion.Id}")</h4>
<div>
    <label>Nombre Cliente:</label>
    <input @bind="nuevaFactura.NombreCliente" placeholder="Nombre del cliente" />
</div>
    <div>
        <label>Fecha:</label>
        <input @bind="nuevaFactura.Fecha" type="date"/>
    </div>

    <h4>@(articuloEdicion == null ? "Agregar Articulo" : "Editando articulo")</h4>
    <div>
        <input @bind="nuevoArticulo.Descripcion" placeholder="Descripción" />
        <input @bind="nuevoArticulo.Cantidad" type="number" placeholder="Cant" style="width: 60px;"/>
        <input @bind="nuevoArticulo.PrecioUnitario" type="number" placeholder="Precio U." style="width: 80px;"/>
        <button @onclick="AgregarOActualizarArticulo">
        @(articuloEdicion == null ? "Agregar Artículo" : "Actualizar Artículo")
    </button>

    @if (articuloEdicion != null)
    {
        <button @onclick="GuardarOActualizarFactura">Cancelar</button>
    }
    </div>
    <ul>
        @foreach (var item in nuevaFactura.Items)
        {
            <li>
                (@item.Cantidad) @item.Descripcion - @item.PrecioUnitario.ToString("C")
                Total: @item.TotalLinea.ToString("C")
                <button @onclick="() => nuevaFactura.Items.Remove(item)">X</button>
                <button @onclick="() => SeleccionarParaEditar(item)">Editar</button>
            </li>
        }
    </ul>
    <h4>Total Factura: @nuevaFactura.Total.ToString("C")</h4>

    <button @onclick="GuardarOActualizarFactura" disabled="@(nuevaFactura.Items.Count == 0)">
        @(facturaEnEdicion == null ? "Guardar Factura" : "Actualizar Factura")
    </button>
    
    @if (facturaEnEdicion != null)
    {
        <button @onclick="CancelarEdicionFactura">Cancelar Edición</button>
    }

<hr style="height: 6px; background-color: rgb(0, 0, 0)">

<h4>Generar Reporte Anual</h4>
<div>
    <label>Año:</label>
    <input @bind="anioReporte" type="number" min="2000" max="2026" style="width: 100px;" />
    <button @onclick="IrAReporte" style="margin-left: 10px;">Generar Reporte</button>
</div>

<hr style="height: 6px; background-color: rgb(0, 0, 0)">
<h4>Facturas Guardadas</h4>
@if (controlador.facturas == null || controlador.facturas.Count == 0)
{
    <p>No hay facturas guardadas.</p>
}
else
{
    <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">ID</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Fecha</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Cliente</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Artículos</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: right;">Total</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: center;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var factura in controlador.facturas)
            {
                <tr>
                    <td style="padding: 8px; border: 1px solid #ddd; vertical-align: top;">@factura.Id</td>
                    <td style="padding: 8px; border: 1px solid #ddd; vertical-align: top;">@factura.Fecha.ToString("yyyy-MM-dd")</td>
                    <td style="padding: 8px; border: 1px solid #ddd; vertical-align: top;">@factura.NombreCliente</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">
                        <ul style="margin: 0; padding-left: 20px;">
                            @foreach (var item in factura.Items)
                            {
                                <li>(@item.Cantidad) @item.Descripcion - @item.PrecioUnitario.ToString("C")</li>
                            }
                        </ul>
                    </td>
                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right; vertical-align: top; font-weight: bold;">
                        @factura.Total.ToString("C")
                    </td>
                    <td style="padding: 8px; border: 1px solid #ddd; text-align: center; vertical-align: middle;">
                        <button @onclick="() => SeleccionarFacturaParaEditar(factura)">Editar</button>
                        <button @onclick="() => EliminarFacturaYRecargar(factura.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Factura nuevaFactura = new Factura();
    private Articulo nuevoArticulo = new Articulo();
    private Articulo articuloEdicion = null;
    private Factura facturaEnEdicion = null;
    // --- variables para el dashboard ---
    private string statsMejorCliente = "---";
    private string statsPlatilloTop = "---";
    private string statsBebidaTop = "---";
    private string statsFacturaCara = "---";
    private string statsFacturaBarata = "---";
    private string statsMejorMes = "---";
    private string statsMejorAnio = "---";
    //Variables de estado 
    private int anioReporte = DateTime.Now.Year;
private static readonly string[] _palabrasClaveBebida = 
    { 
        "vino añejo 20 años", "agua mineral botella", "vino añejo 10 años", "limonada", "cerveza", "vino añejo 25 años", 
        "naranjada"
    };

    protected override void OnInitialized()
    {
        controlador.CargarFacturas();
        CalcularEstadisticas();
    }
    void SeleccionarParaEditar(Articulo item)
    {
        articuloEdicion = item;
        nuevoArticulo = new Articulo
        {
            Descripcion = item.Descripcion,
            Cantidad = item.Cantidad,
            PrecioUnitario = item.PrecioUnitario
        };

    }
    void IrAReporte()
    {
        Navegador.NavigateTo($"/reporte/{anioReporte}");
    }
    void AgregarOActualizarArticulo()
    {
       if (!string.IsNullOrWhiteSpace(nuevoArticulo.Descripcion) && nuevoArticulo.Cantidad > 0 && nuevoArticulo.PrecioUnitario > 0)
        {
            if (articuloEdicion == null)
            {
                var itemParaAgregar = new Articulo
                {
                    Descripcion = nuevoArticulo.Descripcion,
                    Cantidad = nuevoArticulo.Cantidad,
                    PrecioUnitario = nuevoArticulo.PrecioUnitario
                };
                nuevaFactura.Items.Add(itemParaAgregar);
            }
            else
            {
                articuloEdicion.Descripcion = nuevoArticulo.Descripcion;
                articuloEdicion.Cantidad = nuevoArticulo.Cantidad;
                articuloEdicion.PrecioUnitario = nuevoArticulo.PrecioUnitario;
            
            GuardarOActualizarFactura();
        }
        CancelarEdicionArticulo();
    } 
    }
    void CancelarEdicionArticulo()
    {
        nuevoArticulo = new Articulo();
        articuloEdicion = null;
    }
    
    void GuardarOActualizarFactura()
    {
        nuevaFactura.Id = (facturaEnEdicion?.Id ?? 0);

        if (facturaEnEdicion == null)
        {
            controlador.AgregarFactura(nuevaFactura);
        }
        else
        {
            controlador.ActualizarFactura(nuevaFactura);
        }
        CancelarEdicionFactura();
    }
    
    void SeleccionarFacturaParaEditar(Factura factura)
    {
        facturaEnEdicion = factura;
        nuevaFactura = new Factura
        {
            Id = factura.Id,
            Fecha = factura.Fecha,
            NombreCliente = factura.NombreCliente,
            Items = new List<Articulo>()
        };
        foreach (var item in factura.Items)
        {
            nuevaFactura.Items.Add(new Articulo 
            {
                Id = item.Id,
                Descripcion = item.Descripcion,
                Cantidad = item.Cantidad,
                PrecioUnitario = item.PrecioUnitario,
                FacturaId = item.FacturaId
            });
        }
        CancelarEdicionArticulo();
    }
    void EliminarFacturaYRecargar(int id)
    {
        controlador.EliminarFactura(id);
        if (facturaEnEdicion != null && facturaEnEdicion.Id == id)
        {
            CancelarEdicionFactura();
        }
        StateHasChanged();
    }
    void CancelarEdicionFactura()
    {
        nuevaFactura = new Factura();
        facturaEnEdicion = null;
        CancelarEdicionArticulo();
    }
    
    //Metodos para dashboard
    void CalcularEstadisticas()
    {        
        if (controlador.facturas is null || !controlador.facturas.Any()) return;
        var listaFacturas = controlador.facturas;

        CalcularMejorCliente(listaFacturas);
        CalcularProductosTop(listaFacturas);
        CalcularRecordsFacturas(listaFacturas);
        CalcularMejoresTiempos(listaFacturas);
    }
    private void CalcularMejorCliente(List<Factura> facturas)
    {
        var mejor = facturas
            .GroupBy(f => f.NombreCliente)
            .Select(g => new { Cliente = g.Key, Total = g.Sum(f => f.Total) })
            .OrderByDescending(x => x.Total)
            .FirstOrDefault();

        if (mejor != null)
            statsMejorCliente = $"{mejor.Cliente} ({mejor.Total:C})";
    }

    private void CalcularProductosTop(List<Factura> facturas)
    {
        var itemsResumen = facturas
            .SelectMany(f => f.Items)
            .GroupBy(i => i.Descripcion.ToLower().Trim())
            .Select(g => new 
            { 
                Nombre = g.First().Descripcion,
                Cantidad = g.Sum(i => i.Cantidad),
                EsBebida = _palabrasClaveBebida.Any(k => g.Key.Contains(k)) 
            })
            .ToList();

        var topBebida = itemsResumen.Where(x => x.EsBebida).MaxBy(x => x.Cantidad);
        var topPlatillo = itemsResumen.Where(x => !x.EsBebida).MaxBy(x => x.Cantidad);

        statsBebidaTop = topBebida != null ? $"{topBebida.Nombre} ({topBebida.Cantidad})" : "Sin datos";
        statsPlatilloTop = topPlatillo != null ? $"{topPlatillo.Nombre} ({topPlatillo.Cantidad})" : "Sin datos";
    }

    private void CalcularRecordsFacturas(List<Factura> facturas)
    { 
        var cara = facturas.MaxBy(f => f.Total);
        var barata = facturas.MinBy(f => f.Total);

        if (cara != null) statsFacturaCara = $"{cara.Total:C} ({cara.NombreCliente})";
        if (barata != null) statsFacturaBarata = $"{barata.Total:C}";
    }

    private void CalcularMejoresTiempos(List<Factura> facturas)
    {
        var mejorMes = facturas
            .GroupBy(f => new { f.Fecha.Year, f.Fecha.Month })
            .Select(g => new { Fecha = g.Key, Total = g.Sum(f => f.Total) })
            .MaxBy(g => g.Total);

        if (mejorMes != null)
        {
            string nombreMes = new CultureInfo("es-ES").DateTimeFormat.GetMonthName(mejorMes.Fecha.Month);
            statsMejorMes = $"{char.ToUpper(nombreMes[0])}{nombreMes[1..]} {mejorMes.Fecha.Year}";
        }
        var mejorAnio = facturas
            .GroupBy(f => f.Fecha.Year)
            .Select(g => new { Anio = g.Key, Total = g.Sum(f => f.Total) })
            .MaxBy(g => g.Total);

        if (mejorAnio != null) statsMejorAnio = mejorAnio.Anio.ToString();
    }
}
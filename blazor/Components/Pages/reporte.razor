@page "/reporte/{Anio:int}"
@using blazor.Components.Data
@using blazor.Components.Servicios
@using System.Globalization
@rendermode InteractiveServer
@inject ServicioControlador controlador

<title>Reporte Anual @Anio | BaronRojo</title>

<div class="container-dashboard">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div>
            <h1 style="margin:0;">Reporte Financiero</h1>
            <p style="margin:0; color: var(--color-text-muted);">Ejercicio Fiscal @Anio</p>
        </div>
        <a href="/" class="btn-secondary" style="text-decoration: none; padding: 10px 20px; display: inline-block;">
            ← Volver al Dashboard
        </a>
    </div>

    @if (facturasDelAnio == null || !facturasDelAnio.Any())
    {
        <div class="card" style="text-align: center; padding: 50px;">
            <h3>No hay registros</h3>
            <p class="text-muted">No se encontraron facturas registradas para el año @Anio.</p>
            <a href="/" class="btn-primary" style="text-decoration: none;">Crear Factura</a>
        </div>
    }
    else
    {
        @foreach (var grupoMes in facturasDelAnio.GroupBy(f => f.Fecha.Month).OrderBy(g => g.Key))
        {
            var nombreMes = new CultureInfo("es-ES").DateTimeFormat.GetMonthName(grupoMes.Key);
            var tituloMes = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(nombreMes);
            var totalMes = grupoMes.Sum(f => f.Total);

            <div class="card" style="margin-bottom: 30px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 15px;">
                    <h3 style="margin:0; color: var(--color-primary);">@tituloMes</h3>
                    <span style="font-weight:bold; background: #eee; padding: 5px 10px; border-radius: 6px;">
                        Total Mes: @totalMes.ToString("C")
                    </span>
                </div>

                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th class="text-right">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in grupoMes.OrderBy(f => f.Fecha))
                        {
                            <tr>
                                <td>@factura.Id</td>
                                <td>@factura.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>@factura.NombreCliente</td>
                                <td class="text-right">@factura.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card" style="background-color: #2C3E50; color: white;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; color: white;">Total Anual (@Anio)</h2>
                <h2 style="margin: 0; color: #4ade80;">@totalAnual.ToString("C")</h2>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Anio { get; set; }
    private List<Factura> facturasDelAnio = new List<Factura>();
    private decimal totalAnual = 0;

    protected override void OnInitialized()
    {
        controlador.CargarFacturas();
        facturasDelAnio = controlador.facturas
            .Where(f => f.Fecha.Year == Anio && !f.Archivada)
            .ToList();
        
        totalAnual = facturasDelAnio.Sum(f => f.Total);
    }
}